# Optional for HTTPS deployments and required before enabling the public shop.
MYSTUFF_PUBLIC_URL=https://stuff.example.com
VINEXT_TRUSTED_HOSTS=stuff.example.com

# Optional published image override.
# MYSTUFF_IMAGE=ghcr.io/johnnybravo-xyz/mystuff:0.1.0

# Optional secret-manager override. By default a key is generated in /data/secrets.
# ARCHIVE_SESSION_SECRET=

# Advanced compatibility mode: validate an existing forward-auth/OIDC session.
# ARCHIVE_AUTH_MODE=oidc
# ARCHIVE_PUBLIC_URL=https://stuff.example.com
# ARCHIVE_OIDC_AUTH_URL=http://auth-service:4180/oauth2/auth
# ARCHIVE_OIDC_LOGIN_URL=https://login.example.com/oauth2/start
# ARCHIVE_OIDC_LOGOUT_URL=https://login.example.com/oauth2/sign_out

# Optional inventory integration. Blank disables bearer access.
# ARCHIVE_AGENT_TOKEN_SHA256=
